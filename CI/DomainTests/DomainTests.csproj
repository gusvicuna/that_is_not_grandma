<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Shadow project: compiles the pure-C# Domain layer and its EditMode tests
    outside Unity so CI can run them without a Unity license.
    Unity ignores anything outside Assets/, so this file is CI-only.

    It also enforces the architecture rule from CLAUDE.md: Domain must not
    reference UnityEngine. If someone adds that using, this build fails.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>Game.DomainTests</AssemblyName>
    <RootNamespace>Game.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Assets/Game/Scripts/Domain/**/*.cs" />
    <Compile Include="../../Assets/Tests/Editor/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- NUnit 3.x to match the version shipped by Unity Test Framework 1.7.
         NUnit 4 moved the classic asserts to ClassicAssert and would diverge. -->
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
  </ItemGroup>

</Project>
