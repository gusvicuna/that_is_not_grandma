  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1fa0fb36a19452347ba407dd1a6317a6, type: 3}
  m_Name: DLG_Suspicious_Cousin
  m_EditorClassIdentifier: Assembly-CSharp::Game.Data.DialogueSO
  _id: dlg_suspicious_cousin
  _nodes:
  - _speaker: {fileID: 0}
    _speakerType: 1
    _text: Gasp!
    _options: []
    _nextIndex: 1
  - _speaker: {fileID: 11400000, guid: 864a877dacd65e04aa31110ef2ae3534, type: 2}
    _speakerType: 0
    _text: 'What? You look like you''ve seen a ghost. '
    _options: []
    _nextIndex: 2
  - _speaker: {fileID: 11400000, guid: 864a877dacd65e04aa31110ef2ae3534, type: 2}
    _speakerType: 0
    _text: What were you all screaming about? It's giving me a headache.
    _options:
    - _text: ASK HER WHAT'S WRONG WITH GRANDMA
      _targetIndex: 3
    _nextIndex: 3
  - _speaker: {fileID: 0}
    _speakerType: 1
    _text: What was wrong with Grandma?!
    _options: []
    _nextIndex: 4
  - _speaker: {fileID: 11400000, guid: 864a877dacd65e04aa31110ef2ae3534, type: 2}
    _speakerType: 0
    _text: You think Grandma looks weird?
    _options: []
    _nextIndex: 5
  - _speaker: {fileID: 11400000, guid: 864a877dacd65e04aa31110ef2ae3534, type: 2}
    _speakerType: 0
    _text: I don't know what you're talking about.
    _options:
    - _text: INSIST
      _targetIndex: 6
    - _text: ASK
      _targetIndex: 10
    _nextIndex: 6
  - _speaker: {fileID: 0}
    _speakerType: 1
    _text: Something was CLEARLY wrong with her and you know it!
    _options: []
    _nextIndex: 7
  - _speaker: {fileID: 11400000, guid: 864a877dacd65e04aa31110ef2ae3534, type: 2}
    _speakerType: 0
    _text: You should watch what you're saying.
    _options: []
    _nextIndex: 8
  - _speaker: {fileID: 11400000, guid: 864a877dacd65e04aa31110ef2ae3534, type: 2}
    _speakerType: 0
    _text: 'Listen, I''m gonna give you some space, just...

'
    _options: []
    _nextIndex: 9
  - _speaker: {fileID: 11400000, guid: 864a877dacd65e04aa31110ef2ae3534, type: 2}
    _speakerType: 0
    _text: ...don't wander too far.
    _options: []
    _nextIndex: 10
  - _speaker: {fileID: 0}
    _speakerType: 1
    _text: Wait
    _options: []
    _nextIndex: 11
  - _speaker: {fileID: 11400000, guid: 864a877dacd65e04aa31110ef2ae3534, type: 2}
    _speakerType: 1
    _text: do you recognise this glasses?
    _options: []
    _nextIndex: -1
  _allowsClueExchange: 1
  _playsLieMotif: 0
