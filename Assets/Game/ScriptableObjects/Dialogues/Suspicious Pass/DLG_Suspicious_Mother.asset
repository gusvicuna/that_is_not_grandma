  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1fa0fb36a19452347ba407dd1a6317a6, type: 3}
  m_Name: DLG_Suspicious_Mother
  m_EditorClassIdentifier: Assembly-CSharp::Game.Data.DialogueSO
  _id: dlg_suspicious_mother
  _nodes:
  - _speaker: {fileID: 11400000, guid: 98b44ac0ad856a34987953bec09f2f49, type: 2}
    _speakerType: 0
    _text: Your uncle told me what you did. I know I didn't raise such an insolent
      child.
    _options: []
    _nextIndex: 1
  - _speaker: {fileID: 11400000, guid: 98b44ac0ad856a34987953bec09f2f49, type: 2}
    _speakerType: 0
    _text: How could you speak to your Grandmother this way?!
    _options: []
    _nextIndex: 2
  - _speaker: {fileID: 0}
    _speakerType: 1
    _text: But- but... have you not seen-
    _options: []
    _nextIndex: 3
  - _speaker: {fileID: 11400000, guid: 98b44ac0ad856a34987953bec09f2f49, type: 2}
    _speakerType: 0
    _text: 'No buts! '
    _options: []
    _nextIndex: 4
  - _speaker: {fileID: 11400000, guid: 98b44ac0ad856a34987953bec09f2f49, type: 2}
    _speakerType: 0
    _text: I have to continue reading my book.
    _options: []
    _nextIndex: 5
  - _speaker: {fileID: 11400000, guid: 98b44ac0ad856a34987953bec09f2f49, type: 2}
    _speakerType: 0
    _text: And I don't want to hear another peep from you, so leave go watch your
      cartoons or something.
    _options: []
    _nextIndex: -1
  _allowsClueExchange: 1
  _playsLieMotif: 0
