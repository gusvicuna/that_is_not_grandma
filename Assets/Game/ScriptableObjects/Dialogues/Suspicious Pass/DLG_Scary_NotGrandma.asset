  m_Script: {fileID: 11500000, guid: 1fa0fb36a19452347ba407dd1a6317a6, type: 3}
  m_Name: DLG_Scary_NotGrandma
  m_EditorClassIdentifier: Assembly-CSharp::Game.Data.DialogueSO
  _id: dlg_scary_notgrandma
  _nodes:
  - _speaker: {fileID: 11400000, guid: 7d07f184b45977343aff295e2e2a471d, type: 2}
    _speakerType: 0
    _text: Grandchild...
    _options: []
    _nextIndex: 1
  - _speaker: {fileID: 11400000, guid: 7d07f184b45977343aff295e2e2a471d, type: 2}
    _speakerType: 0
    _text: ...are you being bad?
    _options: []
    _nextIndex: 2
  - _speaker: {fileID: 11400000, guid: 7d07f184b45977343aff295e2e2a471d, type: 2}
    _speakerType: 0
    _text: You wouldn't want to make Grandma sad, would you? Be a good kid now, or
      else-
    _options: []
    _nextIndex: 3
  - _speaker: {fileID: 11400000, guid: 864a877dacd65e04aa31110ef2ae3534, type: 2}
    _speakerType: 0
    _text: Ah, I didn't realise...
    _options: []
    _nextIndex: 4
  - _speaker: {fileID: 11400000, guid: 7d07f184b45977343aff295e2e2a471d, type: 2}
    _speakerType: 0
    _text: ...
    _options: []
    _nextIndex: 5
  - _speaker: {fileID: 11400000, guid: 864a877dacd65e04aa31110ef2ae3534, type: 2}
    _speakerType: 0
    _text: I didn't realise anyone was here.
    _options: []
    _nextIndex: 6
  - _speaker: {fileID: 11400000, guid: 864a877dacd65e04aa31110ef2ae3534, type: 2}
    _speakerType: 0
    _text: H-hi, Grandma.
    _options: []
    _nextIndex: 7
  - _speaker: {fileID: 11400000, guid: 864a877dacd65e04aa31110ef2ae3534, type: 2}
    _speakerType: 0
    _text: Cousin...
    _options: []
    _nextIndex: 8
  - _speaker: {fileID: 11400000, guid: 7d07f184b45977343aff295e2e2a471d, type: 2}
    _speakerType: 0
    _text: Dear, did I not tell you not to bother me when I'm talking to your cousin?
    _options: []
    _nextIndex: 9
  - _speaker: {fileID: 11400000, guid: 864a877dacd65e04aa31110ef2ae3534, type: 2}
    _speakerType: 0
    _text: Ye... yes. I'm sorry, Grandma.
    _options: []
    _nextIndex: 10
  - _speaker: {fileID: 11400000, guid: 7d07f184b45977343aff295e2e2a471d, type: 2}
    _speakerType: 0
    _text: 'Alright honey, Grandma will see you later, yes? '
    _options: []
    _nextIndex: 11
  - _speaker: {fileID: 11400000, guid: 7d07f184b45977343aff295e2e2a471d, type: 2}
    _speakerType: 0
    _text: Alright then.
    _options: []
    _nextIndex: -1
  _allowsClueExchange: 0
  _playsLieMotif: 0
