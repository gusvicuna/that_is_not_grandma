  m_Script: {fileID: 11500000, guid: 1fa0fb36a19452347ba407dd1a6317a6, type: 3}
  m_Name: DLG_Suspicious_Uncle
  m_EditorClassIdentifier: Assembly-CSharp::Game.Data.DialogueSO
  _id: dlg_suspicious_uncle
  _nodes:
  - _speaker: {fileID: 11400000, guid: 23e3a82277d512e429cd9cf812e021f3, type: 2}
    _speakerType: 0
    _text: You! Didn't I tell you to stay in your Bedroom?
    _options: []
    _nextIndex: 1
  - _speaker: {fileID: 11400000, guid: 23e3a82277d512e429cd9cf812e021f3, type: 2}
    _speakerType: 0
    _text: What are you doing out here?
    _options: []
    _nextIndex: 2
  - _speaker: {fileID: 0}
    _speakerType: 1
    _text: Nothing, I'm sorry.
    _options: []
    _nextIndex: 3
  - _speaker: {fileID: 11400000, guid: 23e3a82277d512e429cd9cf812e021f3, type: 2}
    _speakerType: 0
    _text: Grandma will not be happy to hear of your behaviour today.
    _options: []
    _nextIndex: 4
  - _speaker: {fileID: 11400000, guid: 23e3a82277d512e429cd9cf812e021f3, type: 2}
    _speakerType: 0
    _text: Not only is she sickly, she has a disrespectful grandkid!
    _options: []
    _nextIndex: 5
  - _speaker: {fileID: 0}
    _speakerType: 1
    _text: Please, Uncle. I just need to ask.
    _options: []
    _nextIndex: -1
  _allowsClueExchange: 1
  _playsLieMotif: 0
